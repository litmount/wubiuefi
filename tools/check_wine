program_files_x86_7zip="$WINEPREFIX/drive_c/Program Files (x86)/7-Zip"
apt_updated=

apt_install(){
	if [ -z "$apt_updated" ]; then
		sudo apt-get update
		apt_updated=1
	fi
	sudo apt-get install -y "$@"
}

apt_add_architecture(){
	if ! dpkg --print-foreign-architectures | grep -qx "$1"; then
		sudo dpkg --add-architecture "$1"
		apt_updated=
	fi
}

display_run(){
	if [ -n "$DISPLAY" ] || ! command -v xvfb-run >/dev/null 2>&1; then
		"$@"
	else
		xvfb-run -a "$@"
	fi
}

wine_run(){
	display_run wine "$@"
}

ensure_wineprefix(){
	if [ ! -e "$WINEPREFIX/system.reg" ]; then
		echo "Initializing wine prefix..."
		WINEARCH=win32 display_run wineboot -u
		wineserver -w || true
	fi
}

download(){
	wget  -P /tmp -O "$2" "$1" || return 1
	md5=$(md5sum $2)
	md5=${md5%% *}
	if [ ! "$md5" = "$3" ]; then
		echo "Invalid download for $1, md5 does not match"
		return 1
	fi
}

download_or_fail(){
	download "$@" || exit 1
}

download_sha256_or_fail(){
	wget -P /tmp -O "$2" "$1" || exit 1
	sha256=$(sha256sum "$2")
	sha256=${sha256%% *}
	if [ ! "$sha256" = "$3" ]; then
		echo "Invalid download for $1, sha256 does not match"
		exit 1
	fi
}

install_7z(){
	echo "Installing 7z..."
	if download "$p7zip_url" "/tmp/p7zip.exe" "$p7zip_md5"; then
		wine_run "/tmp/p7zip.exe" /S
	else
		echo "Falling back to portable 7za..."
		mkdir -p "$program_files_7zip"
		download_sha256_or_fail "$portable_7za_url" "/tmp/7za.exe" "$portable_7za_sha256"
		cp "/tmp/7za.exe" "$program_files_7zip/7za.exe"
	fi
}

install_wine(){
	if [ ! -x /usr/bin/wine -a ! -x /usr/local/bin/wine ] || \
	   ! dpkg-query -W -f='${Status}' wine32:i386 2>/dev/null | grep -q "install ok installed"; then
		apt_add_architecture i386
	fi
	if [ ! -x /usr/bin/wine -a ! -x /usr/local/bin/wine ]; then
		echo "Installing wine..."
		apt_install wine wine32:i386 #TBD do not assume apt
	fi
	if ! dpkg-query -W -f='${Status}' wine32:i386 2>/dev/null | grep -q "install ok installed"; then
		echo "Installing wine32..."
		apt_add_architecture i386
		apt_install wine32:i386 #TBD do not assume apt
	fi
	if [ -z "$DISPLAY" ] && ! command -v xvfb-run >/dev/null 2>&1; then
		echo "Installing xvfb..."
		apt_install xvfb #TBD do not assume apt
	fi
	ensure_wineprefix
}

install_mingw32(){
	if [ ! -x /usr/bin/i686-w64-mingw32-gcc -a ! -x /usr/local/bin/i686-w64-mingw32-gcc ] && \
	   [ ! -x /usr/bin/i586-mingw32msvc-gcc -a ! -x /usr/local/bin/i586-mingw32msvc-gcc ]; then
		echo "Installing mingw32..."
		apt_install gcc-mingw-w64-i686 binutils-mingw-w64-i686 #TBD do not assume apt
	fi
}

install_unzip(){
	if [ ! -x /usr/bin/unzip -a ! -x /usr/local/bin/unzip ]; then
		echo "Installing unzip..."
		apt_install unzip #TBD do not assume apt
	fi
}

install_zip(){
	if [ ! -x /usr/bin/zip -a ! -x /usr/local/bin/zip ]; then
		echo "Installing zip..."
		apt_install zip #TBD do not assume apt
	fi
}

install_gettext(){
	if [ ! -x /usr/bin/msgfmt -a ! -x /usr/local/bin/msgfmt ]; then
		echo "Installing gettext..."
